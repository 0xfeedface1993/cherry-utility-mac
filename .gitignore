# XcodeGen 生成的工程，以 project.yml 为准
/CherryUtility.xcodeproj/

# 独立 Git 仓库，由 CherryKit 自行管理版本
/Packages/CherryKit/

# SwiftPM / Xcode 构建产物与本地状态（包含嵌套包）
.build/
build/
DerivedData/
.swiftpm/
*.xcresult
*.xcarchive/
*.dSYM/
*.profraw
*.profdata

# Python 字节码与缓存
__pycache__/
*.py[cod]

# 本机签名配置与 Xcode 用户设置
/Config/Local.xcconfig
xcuserdata/
*.xcuserstate

# macOS 元数据与编辑器临时文件
.DS_Store
._*
*.swp
*.swo
*~

# 保留 Package.resolved、源码、测试、资源和共享配置

# 官网构建产物与发布产物（由脚本生成）
/Website/dist/
/.release/
/Design/mockups/out/
