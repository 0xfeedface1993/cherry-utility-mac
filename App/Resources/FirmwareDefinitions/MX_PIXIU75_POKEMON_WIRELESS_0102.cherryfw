  "groups": [
    {
      "id": "frow",
      "name": "F 区行为",
      "detail": "原厂固件里 Ctrl+Fn 切换 Fn Lock、Fn+Enter 切换 Win/Mac，两者都会掉电保存，所以 F 区时而需要按 Fn、时而不用。"
    },
    {
      "id": "win",
      "name": "Win 模式 F1–F12 功能",
      "detail": "启用「F 区固定」后，Win 模式下单按 F1–F12 触发这里的功能，Fn+F 键输出 F1–F12。未启用时，是否需要按 Fn 取决于 Fn Lock。"
    },
    {
      "id": "mac",
      "name": "Mac 模式 F1–F12 功能",
      "detail": "启用「F 区固定」后，Mac 模式下单按 F1–F12 触发这里的功能，Fn+F 键输出 F1–F12。未启用时，是否需要按 Fn 取决于 Fn Lock。"
    }
  ],
  "options": [
    {
      "id": "frow.fixed",
      "group": "frow",
      "name": "F 区固定：单按功能，Fn+F 输出 F1–F12",
      "detail": "Win 和 Mac 模式下都固定为单按触发功能、Fn+F 输出 F1–F12，不再受 Fn Lock 影响。由 PIXIU 75 0117 的已验证补丁移植，未经真机验证。",
      "stability": "experimental",
