# homebrew-cask 的 cherry-cli：只装独立命令行 cherry（来自签名并公证的 cherry-<版本>.zip），不依赖 App。
# Scripts/release.sh 把 {{VERSION}}、{{SHA256}} 换成版本号和 zip 的 SHA-256，渲染到 .release/<版本>-<build>/cherry-cli.rb；
# 以 # 开头的顶格行（即本说明）不会进入渲染结果。下载地址是 GitHub Release v<版本> 的附件（与官网同一份文件），
# livecheck 读最新的 GitHub Release；release.sh 每个版本都打 zip，所以与 App 的版本同步。
cask "cherry-cli" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/0xfeedface1993/cherry-utility-mac/releases/download/v#{version}/cherry-#{version}.zip"
  name "CHERRY Utility CLI"
  desc "Command-line tool for configuring CHERRY keyboards"
  homepage "https://odeployer.online/cherry-utility/"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sequoia

  binary "cherry"
end
