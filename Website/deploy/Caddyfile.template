# Generated by Scripts/deploy-website.sh — do not edit in place.
# Local origin for https://odeployer.online/cherry-utility/ : frpc forwards every request whose path starts with
# /cherry-utility (full path, not stripped) to this listener. `bind` keeps it reachable from this Mac only.
http://:{{PORT}} {
	bind 127.0.0.1
	encode zstd gzip

	# Relative links in the page need the trailing slash.
	redir /cherry-utility /cherry-utility/ 308

	handle_path /cherry-utility/* {
		root * "{{DEPLOY_ROOT}}/current"

		# Only existing files get the long cache lifetime; a 404 must stay short-lived at the CDN.
		@dmg {
			path /downloads/*.dmg
			file
		}
		header @dmg {
			Content-Type application/x-apple-diskimage
			Cache-Control "public, max-age=31536000, immutable"
		}
		@checksums {
			path /downloads/*.sha256
			file
		}
		header @checksums Content-Type "text/plain; charset=utf-8"

		# Update feed, manifest and page must never be served stale: Sparkle and the download buttons read them.
		@revalidate path / /index.html /appcast.xml /releases/latest.json
		header @revalidate Cache-Control "public, max-age=0, must-revalidate"
		@appcast path /appcast.xml
		header @appcast Content-Type "application/xml; charset=utf-8"

		@assets path /assets/* /styles.css
		header @assets Cache-Control "public, max-age=3600"

		file_server
	}

	respond 404
}
